# Day 6 - Reverse Integer
# LeetCode Problem 7

# Problem:
# Given an integer, reverse its digits.
# If the reversed number goes outside the
# 32-bit signed integer range, return 0.

# Example:
# Input: 123
# Output: 321
#
# Explanation:
# Reverse the digits of 123.
# Reversed Number = 321


class Solution:
    def reverse(self, x):
        rev = 0
        sign = -1 if x < 0 else 1
        x = abs(x)

        while x > 0:
            digit = x % 10
            rev = rev * 10 + digit
            x = x // 10

        rev = rev * sign

        if rev < -(2**31) or rev > (2**31 - 1):
            return 0

        return rev


# Test the code
obj = Solution()

print("Reversed Number:", obj.reverse(123))
print("Reversed Number:", obj.reverse(-123))
print("Reversed Number:", obj.reverse(120))


