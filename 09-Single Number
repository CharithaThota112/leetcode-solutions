# Day 9 - Single Number
# LeetCode Problem 136

# Problem:
# Every number appears twice except one.
# Find the number that appears only once.

class Solution:
    def singleNumber(self, nums: list[int]) -> int:

        result = 0

        for num in nums:
            result = result ^ num

        return result


