# Day 11 - Remove Duplicates from Sorted Array
# LeetCode Problem 26

# Problem:
# Given a sorted array, remove duplicate elements
# so that each element appears only once.
# Return the number of unique elements.

# Example:
# Input: nums = [1, 1, 2]
# Output: 2
# Modified array: [1, 2]


class Solution:
    def removeDuplicates(self, nums):
        if not nums:
            return 0

        j = 0

        for i in range(1, len(nums)):
            if nums[i] != nums[j]:
                j += 1
                nums[j] = nums[i]

        return j + 1
