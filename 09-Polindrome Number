# Day 9 - Palindrome Number
# LeetCode Problem 9

# Problem:
# Given an integer x, return True if it is a
# palindrome, otherwise return False.
#
# A palindrome number reads the same forward
# and backward.
#
# Example:
# Input: 121
# Output: True
#
# Explanation:
# Reverse of 121 is 121.
# Both numbers are the same.

class Solution:
    def isPalindrome(self, x: int) -> bool:

        # Negative numbers are not palindromes
        if x < 0:
            return False

        original = x
        reversed_num = 0

        while x > 0:
            digit = x % 10
            reversed_num = reversed_num * 10 + digit
            x = x // 10

        return original == reversed_num
